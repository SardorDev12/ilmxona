{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Workers Builds project, which is what CI deploys to.
  // A mismatch is only a warning (CI overrides it), but keeping it honest
  // avoids Workers Builds opening a "fix your config" pull request.
  "name": "ilmxona-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // No WORKER_SELF_REFERENCE binding: OpenNext only needs it to reach
  // itself for on-demand revalidation, which requires a persistent
  // incremental cache and a queue. This app configures neither and uses
  // no `revalidate`, so the binding was unused — and it broke every
  // deploy, because CI renames the script while the binding kept
  // pointing at the old name. Add it back alongside the R2 cache below.
  //
  // --- Optional, add once the resources exist ---
  //
  // R2 incremental cache (persists ISR/cache across deploys — otherwise
  // it's in-memory per Worker instance). Create the bucket first:
  //   npx wrangler r2 bucket create ilmxona-opennext-cache
  // then uncomment this block AND swap open-next.config.ts to use
  // `r2IncrementalCache` (see the commented example in that file).
  //
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ilmxona-opennext-cache" }
  // ],
  //
  // Cloudflare Images (for next/image optimization at the edge):
  // "images": { "binding": "IMAGES" }
}
