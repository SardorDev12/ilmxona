# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser. Needed later for admin actions
# that bypass RLS (e.g. suspending a user). Not used in Phase 1 yet.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase Postgres, via Prisma) ---
# Project Settings → Database → Connection string
# Pooled (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL=
# Direct (port 5432) — used by `prisma migrate` only.
DIRECT_URL=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
